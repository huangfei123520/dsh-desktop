#!/bin/bash
# serve portal page with dynamic NAS host + port
APP="dsh-desktop"
PERSIST="/vol1/@apphome/${APP}"
PORT=$(cat "${PERSIST}/port" 2>/dev/null || echo 19090)
cat <<HTMLEOF
Content-Type: text/html; charset=utf-8

<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
<title>DSH 桌面</title>
<style>
  html,body{margin:0;padding:0;height:100%;overflow:hidden;background:#0d0d14}
  iframe{border:0;width:100%;height:100%}
  .tip{position:fixed;top:45%;width:100%;text-align:center;color:#8a8fa8;font-family:sans-serif;font-size:14px}
</style>
</head>
<body>
<div class="tip" id="tip">正在连接 DSH 桌面服务 (端口 ${PORT})...</div>
<iframe id="frame" style="display:none" frameborder="0"></iframe>
<script>
  var port = "${PORT}";
  var host = location.hostname;
  var url = "http://" + host + ":" + port + "/";
  var f = document.getElementById("frame");
  var t = document.getElementById("tip");
  fetch(url, {mode: "no-cors"}).catch(function(){});
  setTimeout(function(){
    t.style.display = "none";
    f.style.display = "block";
    f.src = url;
  }, 1500);
</script>
</body>
</html>
HTMLEOF
exit 0
